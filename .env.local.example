# aolda-ahp-backend API (로컬 기본 포트: 8001)
# 연동 엔드포인트:
#   GET /cloud/brief          — 메인 지표
#   GET /cloud/use_project    — 메인 사용처
#   GET /cloud/qna            — FAQ
#   GET /cloud/notice         — 공지 목록
#   GET /cloud/notice/:id     — 공지 상세
#   GET /cloud/product        — 제품 목록
#   GET /cloud/product/:id    — 제품 상세
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# 서버 전용으로 쓰려면 아래도 가능 (config.ts에서 함께 참조)
# API_BASE_URL=http://localhost:8001

# 백엔드 없이 mock API 테스트 (aolda-ahp-backend constants/cloud.ts 와 동일 데이터)
# USE_MOCK_API=true
# NEXT_PUBLIC_USE_MOCK_API=true
# 또는: cp .env.mock .env.local  /  yarn dev:mock
