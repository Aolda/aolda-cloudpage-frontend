{
  "name": "aolda-homepage-v3",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "backend:up": "docker compose -f docker-compose.backend.yml up -d --build",
    "backend:down": "docker compose -f docker-compose.backend.yml down",
    "backend:logs": "docker compose -f docker-compose.backend.yml logs -f aolda-backend"
  },
  "dependencies": {
    "@types/styled-components": "^5.1.35",
    "isomorphic-dompurify": "^2.25.0",
    "next": "^14.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
